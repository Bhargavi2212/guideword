   "plant_file": {
    "plant_id": "case_d",
    "schema_version": "1.0",
    "notes": [
     {
      "text": "Feed: crude C4 cut from an olefins plant (butanes, butenes, 1,3-butadiene ~45%, traces of acetylenes and water).",
      "source": "cases/dev/source/case_d_c4_unit.md"
     },
     {
      "text": "Products: 1,3-butadiene (99.5%+) to two pressurised storage spheres; raffinate (butanes/butenes) to a pipeline; heavies to fuel.",
      "source": "cases/dev/source/case_d_c4_unit.md"
     },
     {
      "text": "Relief valves on all columns, drums and pump discharge to the flare.",
      "source": "cases/dev/source/case_d_c4_unit.md"
     },
     {
      "text": "Wall-thickness checks by ultrasonic testing on the main process circuits every 5 years.",
      "source": "cases/dev/source/case_d_c4_unit.md"
     },
     {
      "text": "Unit is about 300 m from the site boundary; residential area 1 km away.",
      "source": "cases/dev/source/case_d_c4_unit.md"
     }
    ],
