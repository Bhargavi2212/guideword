  "procedures": [
    {
      "id": "P-E-SHUTDOWN",
      "kind": "shutdown",
      "notes": [
        {
          "text": "Planned shutdown procedure (summary of the written procedure)",
          "source": "cases/dev/source/case_e_fcc_shutdown.md"
        }
      ],
      "steps": [
        {
          "id": "P-E-SHUTDOWN-1",
          "text": "Reduce feed to minimum, then cut feed. Keep riser steam on.",
          "equipment_ids": [
            "RISER"
          ]
        },
        {
          "id": "P-E-SHUTDOWN-2",
          "text": "Reduce main air blower rate. Keep the regenerator hot with torch oil if needed.",
          "equipment_ids": [
            "MAIN-AIR-BLOWER",
            "REGENERATOR"
          ]
        },
        {
          "id": "P-E-SHUTDOWN-3",
          "text": "Withdraw catalyst from the regenerator to the spent catalyst hopper.",
          "equipment_ids": [
            "REGENERATOR",
            "SPENT-CATALYST-HOPPER"
          ]
        },
        {
          "id": "P-E-SHUTDOWN-4",
          "text": "Close both slide valves as the catalyst inventory reaches minimum.",
          "valve_ids": [
            "SV-SPENT",
            "SV-REGEN"
          ]
        },
        {
          "id": "P-E-SHUTDOWN-5",
          "text": "Steam-purge the reactor and the main fractionator to the flare.",
          "equipment_ids": [
            "RISER",
            "MAIN-FRACTIONATOR"
          ]
        },
        {
          "id": "P-E-SHUTDOWN-6",
          "text": "Shut down the wet gas compressor; depressure the gas plant to the flare.",
          "equipment_ids": [
            "WET-GAS-COMPRESSOR",
            "ABSORBER",
            "STRIPPER",
            "DEBUTANISER"
          ]
        },
        {
          "id": "P-E-SHUTDOWN-7",
          "text": "Shut down the main air blower; cool the regenerator.",
          "equipment_ids": [
            "MAIN-AIR-BLOWER",
            "REGENERATOR"
          ]
        },
        {
          "id": "P-E-SHUTDOWN-8",
          "text": "Isolate and blind for maintenance entry."
        }
      ]
    }
  ],
