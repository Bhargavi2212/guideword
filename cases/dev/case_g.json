{
  "plant_id": "case_g",
  "schema_version": "1.0",
  "notes": [
    {
      "text": "Silicone emulsions, release coatings and lubricant blends, made in batches of 2–8 tonnes.",
      "source": "cases/dev/source/case_g_batch_plant.md"
    },
    {
      "text": "Raw materials kept on site (all arrive in 1,000-litre IBC totes or drums)",
      "source": "cases/dev/source/case_g_batch_plant.md"
    },
    {
      "text": "Electrical area classification: unclassified, general-purpose equipment throughout.",
      "source": "cases/dev/source/case_g_batch_plant.md"
    },
    {
      "text": "Personal protective equipment: gloves, goggles, chemical aprons.",
      "source": "cases/dev/source/case_g_batch_plant.md"
    }
  ],
