{
  "$defs": {
    "EventType": {
      "enum": [
        "run_started",
        "step_started",
        "step_finished",
        "agent_decision",
        "dispatch",
        "model_call",
        "tool_call",
        "finding_added",
        "chain_added",
        "lopa_done",
        "evidence_added",
        "coverage_updated",
        "cap_hit",
        "run_finished",
        "run_failed",
        "hypothesis_added",
        "hypothesis_dropped",
        "run_extended",
        "calculations_reattached"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Identified by (run_id, seq); events are a log, not part of the replay comparison.",
  "properties": {
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Error"
    },
    "payload_invalid": {
      "default": false,
      "title": "Payload Invalid",
      "type": "boolean"
    },
    "payload_schema": {
      "anyOf": [
        {
          "const": "v1.9",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Schema"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "time": {
      "format": "date-time",
      "title": "Time",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    }
  },
  "required": [
    "run_id",
    "seq",
    "type",
    "payload",
    "time"
  ],
  "title": "Event",
  "type": "object"
}
