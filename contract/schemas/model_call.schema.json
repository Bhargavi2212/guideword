{
  "$defs": {
    "Tier": {
      "description": "Model tiers; config/routing.yaml maps jobs to these, the live model list to IDs.",
      "enum": [
        "ultra",
        "super",
        "lightning",
        "nano"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Stored per (run_id, id): a cached response reused by another run is a second record.",
  "properties": {
    "attempts": {
      "default": 1,
      "minimum": 1,
      "title": "Attempts",
      "type": "integer"
    },
    "cache_hit": {
      "title": "Cache Hit",
      "type": "boolean"
    },
    "cap_cost_usd": {
      "default": 0.0,
      "minimum": 0,
      "title": "Cap Cost Usd",
      "type": "number"
    },
    "cost_usd": {
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "finish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finish Reason"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "job": {
      "title": "Job",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "ok",
        "invalid",
        "truncated",
        "error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "raw_response": {
      "title": "Raw Response",
      "type": "string"
    },
    "reasoning_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoning Text"
    },
    "record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Record Ids",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "run_id",
    "model_id",
    "prompt_version",
    "job",
    "cache_hit",
    "outcome",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "cost_usd",
    "raw_response"
  ],
  "title": "ModelCall",
  "type": "object"
}
