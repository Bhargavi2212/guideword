{
  "$defs": {
    "ModelCall": {
      "additionalProperties": false,
      "description": "Stored per (run_id, id): a cached response reused by another run is a second record.",
      "properties": {
        "attempts": {
          "default": 1,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "cache_hit": {
          "title": "Cache Hit",
          "type": "boolean"
        },
        "cap_cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cap Cost Usd",
          "type": "number"
        },
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "job": {
          "title": "Job",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "ok",
            "invalid",
            "truncated",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "raw_response": {
          "title": "Raw Response",
          "type": "string"
        },
        "reasoning_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Text"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "run_id",
        "model_id",
        "prompt_version",
        "job",
        "cache_hit",
        "outcome",
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "cost_usd",
        "raw_response"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "RunLabel": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "kind": {
          "$ref": "#/$defs/RunLabelKind"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunLabel",
      "type": "object"
    },
    "RunLabelKind": {
      "enum": [
        "live",
        "recorded",
        "mock"
      ],
      "title": "RunLabelKind",
      "type": "string"
    },
    "Tier": {
      "description": "Model tiers; config/routing.yaml maps jobs to these, the live model list to IDs.",
      "enum": [
        "ultra",
        "super",
        "lightning",
        "nano"
      ],
      "title": "Tier",
      "type": "string"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "agent_step_id": {
          "title": "Agent Step Id",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "refused_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refused Reason"
        },
        "result": {
          "title": "Result"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "title": "Source Urls",
          "type": "array"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "agent_step_id",
        "tool",
        "arguments",
        "result"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "label": {
      "$ref": "#/$defs/RunLabel"
    },
    "model_calls": {
      "items": {
        "$ref": "#/$defs/ModelCall"
      },
      "title": "Model Calls",
      "type": "array"
    },
    "parent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Parent Ids",
      "type": "array"
    },
    "record": {
      "additionalProperties": true,
      "title": "Record",
      "type": "object"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "record_kind": {
      "title": "Record Kind",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    }
  },
  "required": [
    "label",
    "run_id",
    "record_id",
    "record_kind",
    "record",
    "parent_ids",
    "model_calls",
    "tool_calls"
  ],
  "title": "RecordDetail",
  "type": "object"
}
