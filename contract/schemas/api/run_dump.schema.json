{
  "$defs": {
    "Adequacy": {
      "enum": [
        "adequate",
        "inadequate",
        "unknown"
      ],
      "title": "Adequacy",
      "type": "string"
    },
    "AppliedModifier": {
      "additionalProperties": false,
      "properties": {
        "modifier_id": {
          "title": "Modifier Id",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "modifier_id",
        "value"
      ],
      "title": "AppliedModifier",
      "type": "object"
    },
    "Chain": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "links": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Links",
          "type": "array"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "multi_failure": {
          "const": true,
          "default": true,
          "title": "Multi Failure",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "links",
        "description",
        "reason"
      ],
      "title": "Chain",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "sure",
        "unsure"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Identified by (run_id, seq); events are a log, not part of the replay comparison.",
      "properties": {
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "time": {
          "format": "date-time",
          "title": "Time",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        }
      },
      "required": [
        "run_id",
        "seq",
        "type",
        "payload",
        "time"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "run_started",
        "step_started",
        "step_finished",
        "agent_decision",
        "dispatch",
        "model_call",
        "tool_call",
        "finding_added",
        "chain_added",
        "lopa_done",
        "evidence_added",
        "coverage_updated",
        "cap_hit",
        "run_finished",
        "run_failed",
        "hypothesis_added",
        "hypothesis_dropped"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "id",
        "run_id",
        "target_id",
        "kind",
        "verdict",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "calculation",
        "precedent",
        "simulation"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "FailingComponentType": {
      "description": "The values used in reference/causes.csv.",
      "enum": [
        "control_loop",
        "pump",
        "compressor",
        "check_valve",
        "regulator",
        "relief_device",
        "exchanger_tube",
        "interlock",
        "operator",
        "hose",
        "pipe",
        "tank",
        "external",
        "solids_handler",
        "utility_cooling",
        "utility_power"
      ],
      "title": "FailingComponentType",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "adequacy": {
          "$ref": "#/$defs/Adequacy"
        },
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "cause_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause Text"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "consequence": {
          "title": "Consequence",
          "type": "string"
        },
        "failing_component_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Failing Component Ids",
          "type": "array"
        },
        "failing_component_type": {
          "$ref": "#/$defs/FailingComponentType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "safeguard_ids": {
          "items": {
            "type": "string"
          },
          "title": "Safeguard Ids",
          "type": "array"
        },
        "severity_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeverityClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Reason"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "id",
        "run_id",
        "question_id",
        "tier",
        "cause_id",
        "failing_component_type",
        "failing_component_ids",
        "consequence",
        "adequacy",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "One hypothesis of the whole-plant pass (R50), as validated. Immutable: its question\nlinks are set when it is created; whether findings support it is computed when read.",
      "properties": {
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "cause_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause Text"
        },
        "chemical_ids": {
          "items": {
            "type": "string"
          },
          "title": "Chemical Ids",
          "type": "array"
        },
        "component_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Component Ids",
          "type": "array"
        },
        "consequence": {
          "title": "Consequence",
          "type": "string"
        },
        "failing_component_type": {
          "$ref": "#/$defs/FailingComponentType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mechanism": {
          "title": "Mechanism",
          "type": "string"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "question_ids": {
          "items": {
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "rank",
        "mechanism",
        "component_ids",
        "failing_component_type",
        "cause_id",
        "consequence",
        "reason"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "LayerCredit": {
      "additionalProperties": false,
      "properties": {
        "credited": {
          "title": "Credited",
          "type": "boolean"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "layer_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer Type"
        },
        "pfd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pfd"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "layer_id",
        "credited",
        "reason"
      ],
      "title": "LayerCredit",
      "type": "object"
    },
    "LopaRecord": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "frequency_assumed": {
          "default": false,
          "title": "Frequency Assumed",
          "type": "boolean"
        },
        "gap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "initiating_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initiating Event Id"
        },
        "initiating_frequency_per_year": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initiating Frequency Per Year"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/LayerCredit"
          },
          "title": "Layers",
          "type": "array"
        },
        "missing_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fact Ids",
          "type": "array"
        },
        "mitigated_frequency_per_year": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mitigated Frequency Per Year"
        },
        "modifiers": {
          "items": {
            "$ref": "#/$defs/AppliedModifier"
          },
          "title": "Modifiers",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "severity_class": {
          "$ref": "#/$defs/SeverityClass"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "tolerable_per_year": {
          "exclusiveMinimum": 0,
          "title": "Tolerable Per Year",
          "type": "number"
        }
      },
      "required": [
        "id",
        "run_id",
        "target_id",
        "severity_class",
        "complete",
        "tolerable_per_year"
      ],
      "title": "LopaRecord",
      "type": "object"
    },
    "Override": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/OverrideAction"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "by": {
          "title": "By",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "new_value": {
          "title": "New Value"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "replaces": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "target_id",
        "action",
        "new_value",
        "reason",
        "by",
        "at"
      ],
      "title": "Override",
      "type": "object"
    },
    "OverrideAction": {
      "enum": [
        "accept",
        "reject",
        "edit",
        "change_credit",
        "change_severity",
        "answer"
      ],
      "title": "OverrideAction",
      "type": "string"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/QuestionKind"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "not_credible_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Credible Reason"
        },
        "origin": {
          "$ref": "#/$defs/QuestionOrigin"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "status": {
          "$ref": "#/$defs/QuestionStatus"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "kind",
        "origin",
        "status",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "QuestionKind": {
      "enum": [
        "matrix",
        "chemical_pair",
        "chemical_environment",
        "no_flow_line",
        "procedure_step",
        "planned_work",
        "dust",
        "relief_discharge",
        "added_by_ai",
        "engineer"
      ],
      "title": "QuestionKind",
      "type": "string"
    },
    "QuestionOrigin": {
      "enum": [
        "matrix",
        "cross_list",
        "added_by_ai",
        "engineer"
      ],
      "title": "QuestionOrigin",
      "type": "string"
    },
    "QuestionStatus": {
      "description": "`answered` and `not_credible` count as checked. Unsure is a confidence, not a status.",
      "enum": [
        "open",
        "answered",
        "not_credible",
        "failed"
      ],
      "title": "QuestionStatus",
      "type": "string"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "target_id",
        "action",
        "reason"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "cap_spent_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cap Spent Usd",
          "type": "number"
        },
        "caps": {
          "additionalProperties": true,
          "title": "Caps",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/RunLabel"
        },
        "mode": {
          "enum": [
            "full",
            "sample"
          ],
          "title": "Mode",
          "type": "string"
        },
        "plant_record_id": {
          "title": "Plant Record Id",
          "type": "string"
        },
        "prompt_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "reference_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reference Versions",
          "type": "object"
        },
        "routing_config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Routing Config",
          "type": "object"
        },
        "section_snapshot": {
          "items": {
            "type": "string"
          },
          "title": "Section Snapshot",
          "type": "array"
        },
        "spend_cap_usd": {
          "exclusiveMinimum": 0,
          "title": "Spend Cap Usd",
          "type": "number"
        },
        "spent_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Spent Usd",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "step": {
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "id",
        "plant_record_id",
        "attempt",
        "section_snapshot",
        "status",
        "step",
        "mode",
        "spend_cap_usd",
        "reference_versions",
        "routing_config",
        "caps",
        "prompt_versions",
        "label"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunLabel": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "kind": {
          "$ref": "#/$defs/RunLabelKind"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunLabel",
      "type": "object"
    },
    "RunLabelKind": {
      "enum": [
        "live",
        "recorded",
        "mock"
      ],
      "title": "RunLabelKind",
      "type": "string"
    },
    "RunStatus": {
      "description": "`draft` = run created, setup not yet done (D9).",
      "enum": [
        "draft",
        "running",
        "finished",
        "stopped_cap",
        "stopped_budget",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "drawn_by": {
          "enum": [
            "rule",
            "suggestion",
            "engineer"
          ],
          "title": "Drawn By",
          "type": "string"
        },
        "flagged_no_flow": {
          "default": false,
          "title": "Flagged No Flow",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SectionKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "object_ids": {
          "items": {
            "type": "string"
          },
          "title": "Object Ids",
          "type": "array"
        },
        "plant_record_id": {
          "title": "Plant Record Id",
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "section_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/SectionType"
            },
            {
              "type": "null"
