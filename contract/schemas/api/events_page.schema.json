{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "description": "Identified by (run_id, seq); events are a log, not part of the replay comparison.",
      "properties": {
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "payload_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Error"
        },
        "payload_invalid": {
          "default": false,
          "title": "Payload Invalid",
          "type": "boolean"
        },
        "payload_schema": {
          "anyOf": [
            {
              "const": "v1.9",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Schema"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "time": {
          "format": "date-time",
          "title": "Time",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        }
      },
      "required": [
        "run_id",
        "seq",
        "type",
        "payload",
        "time"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "run_started",
        "step_started",
        "step_finished",
        "agent_decision",
        "dispatch",
        "model_call",
        "tool_call",
        "finding_added",
        "chain_added",
        "lopa_done",
        "evidence_added",
        "coverage_updated",
        "cap_hit",
        "run_finished",
        "run_failed",
        "hypothesis_added",
        "hypothesis_dropped",
        "run_extended"
      ],
      "title": "EventType",
      "type": "string"
    },
    "RunLabel": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "kind": {
          "$ref": "#/$defs/RunLabelKind"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunLabel",
      "type": "object"
    },
    "RunLabelKind": {
      "enum": [
        "live",
        "recorded",
        "mock"
      ],
      "title": "RunLabelKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "label": {
      "$ref": "#/$defs/RunLabel"
    },
    "next_after": {
      "title": "Next After",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "label",
    "run_id",
    "events",
    "next_after"
  ],
  "title": "EventsPage",
  "type": "object"
}
