{
  "$defs": {
    "RunLabel": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "kind": {
          "$ref": "#/$defs/RunLabelKind"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunLabel",
      "type": "object"
    },
    "RunLabelKind": {
      "enum": [
        "live",
        "recorded",
        "mock"
      ],
      "title": "RunLabelKind",
      "type": "string"
    },
    "RunStatus": {
      "description": "`draft` = run created, setup not yet done (D9).",
      "enum": [
        "draft",
        "running",
        "finished",
        "stopped_cap",
        "stopped_budget",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "label": {
      "$ref": "#/$defs/RunLabel"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    }
  },
  "required": [
    "label",
    "run_id",
    "status"
  ],
  "title": "RunStatusResult",
  "type": "object"
}
