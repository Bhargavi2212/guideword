{
  "$defs": {
    "BudgetUse": {
      "enum": [
        "development",
        "test_5",
        "benchmark",
        "video",
        "demo_recording",
        "judging",
        "buffer"
      ],
      "title": "BudgetUse",
      "type": "string"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "cap_spent_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cap Spent Usd",
          "type": "number"
        },
        "caps": {
          "additionalProperties": true,
          "title": "Caps",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/RunLabel"
        },
        "mode": {
          "enum": [
            "full",
            "sample"
          ],
          "title": "Mode",
          "type": "string"
        },
        "plant_record_id": {
          "title": "Plant Record Id",
          "type": "string"
        },
        "post_spend_cap_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Post Spend Cap Usd",
          "type": "number"
        },
        "prompt_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "reference_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reference Versions",
          "type": "object"
        },
        "routing_config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Routing Config",
          "type": "object"
        },
        "section_snapshot": {
          "items": {
            "type": "string"
          },
          "title": "Section Snapshot",
          "type": "array"
        },
        "spend_cap_usd": {
          "exclusiveMinimum": 0,
          "title": "Spend Cap Usd",
          "type": "number"
        },
        "spent_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Spent Usd",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "use": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetUse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "plant_record_id",
        "attempt",
        "section_snapshot",
        "status",
        "step",
        "mode",
        "spend_cap_usd",
        "reference_versions",
        "routing_config",
        "caps",
        "prompt_versions",
        "label"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunCounts": {
      "additionalProperties": false,
      "properties": {
        "chains": {
          "title": "Chains",
          "type": "integer"
        },
        "findings": {
          "title": "Findings",
          "type": "integer"
        },
        "questions_checked": {
          "title": "Questions Checked",
          "type": "integer"
        },
        "questions_failed": {
          "title": "Questions Failed",
          "type": "integer"
        },
        "questions_open": {
          "title": "Questions Open",
          "type": "integer"
        },
        "questions_total": {
          "title": "Questions Total",
          "type": "integer"
        },
        "questions_unsure": {
          "title": "Questions Unsure",
          "type": "integer"
        }
      },
      "required": [
        "questions_total",
        "questions_open",
        "questions_checked",
        "questions_failed",
        "questions_unsure",
        "findings",
        "chains"
      ],
      "title": "RunCounts",
      "type": "object"
    },
    "RunLabel": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "kind": {
          "$ref": "#/$defs/RunLabelKind"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunLabel",
      "type": "object"
    },
    "RunLabelKind": {
      "enum": [
        "live",
        "recorded",
        "mock"
      ],
      "title": "RunLabelKind",
      "type": "string"
    },
    "RunStatus": {
      "description": "`draft` = run created, setup not yet done (D9).",
      "enum": [
        "draft",
        "running",
        "finished",
        "stopped_cap",
        "stopped_budget",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "counts": {
      "$ref": "#/$defs/RunCounts"
    },
    "label": {
      "$ref": "#/$defs/RunLabel"
    },
    "run": {
      "$ref": "#/$defs/Run"
    }
  },
  "required": [
    "label",
    "run",
    "counts"
  ],
  "title": "RunDetail",
  "type": "object"
}
