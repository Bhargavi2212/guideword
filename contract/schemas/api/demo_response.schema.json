{
  "$defs": {
    "Adequacy": {
      "enum": [
        "adequate",
        "inadequate",
        "unknown"
      ],
      "title": "Adequacy",
      "type": "string"
    },
    "AppliedModifier": {
      "additionalProperties": false,
      "properties": {
        "modifier_id": {
          "title": "Modifier Id",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "modifier_id",
        "value"
      ],
      "title": "AppliedModifier",
      "type": "object"
    },
    "BudgetUse": {
      "enum": [
        "development",
        "test_5",
        "benchmark",
        "video",
        "demo_recording",
        "judging",
        "buffer"
      ],
      "title": "BudgetUse",
      "type": "string"
    },
    "Chain": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "links": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Links",
          "type": "array"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "multi_failure": {
          "const": true,
          "default": true,
          "title": "Multi Failure",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "severity_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeverityClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Reason"
        }
      },
      "required": [
        "id",
        "run_id",
        "links",
        "description",
        "reason"
      ],
      "title": "Chain",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "sure",
        "unsure"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DemoRun": {
      "additionalProperties": false,
      "description": "A run the site's plant picker offers (contract v1.11, review plan R0): its banner as\nBhargavi wrote it, with the start line's served rank filled in, and that line. A banner\nthat names a line not on the shortlist is left out.",
      "properties": {
        "banner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Banner"
        },
        "plant_id": {
          "title": "Plant Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "start_target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Target Id"
        }
      },
      "required": [
        "run_id",
        "plant_id"
      ],
      "title": "DemoRun",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "calculation",
        "precedent",
        "simulation"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "FailingComponentType": {
      "description": "The values used in reference/causes.csv.",
      "enum": [
        "control_loop",
        "pump",
        "compressor",
        "check_valve",
        "regulator",
        "relief_device",
        "exchanger_tube",
        "interlock",
        "operator",
        "hose",
        "pipe",
        "tank",
        "external",
        "solids_handler",
        "utility_cooling",
        "utility_power"
      ],
      "title": "FailingComponentType",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "adequacy": {
          "$ref": "#/$defs/Adequacy"
        },
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "cause_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause Text"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "consequence": {
          "title": "Consequence",
          "type": "string"
        },
        "failing_component_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Failing Component Ids",
          "type": "array"
        },
        "failing_component_type": {
          "$ref": "#/$defs/FailingComponentType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "safeguard_ids": {
          "items": {
            "type": "string"
          },
          "title": "Safeguard Ids",
          "type": "array"
        },
        "severity_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeverityClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Reason"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "id",
        "run_id",
        "question_id",
        "tier",
        "cause_id",
        "failing_component_type",
        "failing_component_ids",
        "consequence",
        "adequacy",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "One hypothesis of the whole-plant pass (R50), as validated. Immutable: its question\nlinks are set when it is created; whether findings support it is computed when read.",
      "properties": {
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "cause_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause Text"
        },
        "chemical_ids": {
          "items": {
            "type": "string"
          },
          "title": "Chemical Ids",
          "type": "array"
        },
        "component_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Component Ids",
          "type": "array"
        },
        "consequence": {
          "title": "Consequence",
          "type": "string"
        },
        "failing_component_type": {
          "$ref": "#/$defs/FailingComponentType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mechanism": {
          "title": "Mechanism",
          "type": "string"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "question_ids": {
          "items": {
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "rank",
        "mechanism",
        "component_ids",
        "failing_component_type",
        "cause_id",
        "consequence",
        "reason"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "A plant validation error or warning (schema/validate.py), naming the offending ID.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Object Id"
        }
      },
      "required": [
        "code",
        "object_id",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "LayerCredit": {
      "additionalProperties": false,
      "properties": {
        "applies": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies"
        },
        "argument": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argument"
        },
        "credited": {
          "title": "Credited",
          "type": "boolean"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "layer_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer Type"
        },
        "pfd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pfd"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "layer_id",
        "credited",
        "reason"
      ],
      "title": "LayerCredit",
      "type": "object"
    },
    "LopaRecord": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "frequency_assumed": {
          "default": false,
          "title": "Frequency Assumed",
          "type": "boolean"
        },
        "gap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "initiating_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initiating Event Id"
        },
        "initiating_frequency_per_year": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initiating Frequency Per Year"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/LayerCredit"
          },
          "title": "Layers",
          "type": "array"
        },
        "missing_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fact Ids",
          "type": "array"
        },
        "mitigated_frequency_per_year": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mitigated Frequency Per Year"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "modifiers": {
          "items": {
            "$ref": "#/$defs/AppliedModifier"
          },
          "title": "Modifiers",
          "type": "array"
        },
        "modifiers_not_applied": {
          "items": {
            "$ref": "#/$defs/ModifierNotApplied"
          },
          "title": "Modifiers Not Applied",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "severity_class": {
          "$ref": "#/$defs/SeverityClass"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "tolerable_per_year": {
          "exclusiveMinimum": 0,
          "title": "Tolerable Per Year",
          "type": "number"
        }
      },
      "required": [
        "id",
        "run_id",
        "target_id",
        "severity_class",
        "complete",
        "tolerable_per_year"
      ],
      "title": "LopaRecord",
      "type": "object"
    },
    "ModifierNotApplied": {
      "additionalProperties": false,
      "description": "A modifier kind of modifiers.csv the record did not apply, and why (P3-3).",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "ModifierNotApplied",
      "type": "object"
    },
    "PlantDetail": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "items": {
            "$ref": "#/$defs/PlantFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "plant_id": {
          "title": "Plant Id",
          "type": "string"
        },
        "plant_record_id": {
          "title": "Plant Record Id",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/PlantStatus"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "plant_record_id",
        "plant_id",
        "status",
        "facts",
        "warnings",
        "sections"
      ],
      "title": "PlantDetail",
      "type": "object"
    },
    "PlantFact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "plant_record_id": {
          "title": "Plant Record Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "id",
        "plant_record_id",
        "value",
        "source"
      ],
      "title": "PlantFact",
      "type": "object"
    },
    "PlantStatus": {
      "enum": [
        "uploaded",
        "sections_proposed",
        "sections_confirmed"
      ],
      "title": "PlantStatus",
      "type": "string"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "target_id",
        "action",
        "reason"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "cap_spent_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cap Spent Usd",
          "type": "number"
        },
        "caps": {
          "additionalProperties": true,
          "title": "Caps",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/RunLabel"
        },
        "mode": {
          "enum": [
            "full",
            "sample"
          ],
          "title": "Mode",
          "type": "string"
        },
        "plant_record_id": {
          "title": "Plant Record Id",
          "type": "string"
        },
        "post_spend_cap_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Post Spend Cap Usd",
          "type": "number"
        },
        "prompt_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "reference_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reference Versions",
          "type": "object"
        },
        "routing_config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Routing Config",
          "type": "object"
        },
        "section_snapshot": {
          "items": {
            "type": "string"
          },
          "title": "Section Snapshot",
          "type": "array"
        },
        "spend_cap_usd": {
          "exclusiveMinimum": 0,
          "title": "Spend Cap Usd",
          "type": "number"
        },
        "spent_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Spent Usd",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "use": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetUse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "plant_record_id",
        "attempt",
        "section_snapshot",
        "status",
        "step",
        "mode",
        "spend_cap_usd",
        "reference_versions",
        "routing_config",
        "caps",
        "prompt_versions",
        "label"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunCounts": {
      "additionalProperties": false,
      "properties": {
        "chains": {
          "title": "Chains",
          "type": "integer"
        },
        "findings": {
          "title": "Findings",
          "type": "integer"
        },
        "questions_checked": {
          "title": "Questions Checked",
          "type": "integer"
        },
        "questions_failed": {
          "title": "Questions Failed",
          "type": "integer"
        },
        "questions_open": {
          "title": "Questions Open",
          "type": "integer"
        },
        "questions_total": {
          "title": "Questions Total",
          "type": "integer"
        },
        "questions_unsure": {
          "title": "Questions Unsure",
          "type": "integer"
        }
      },
      "required": [
        "questions_total",
        "questions_open",
        "questions_checked",
        "questions_failed",
        "questions_unsure",
        "findings",
        "chains"
      ],
      "title": "RunCounts",
      "type": "object"
    },
    "RunDetail": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "$ref": "#/$defs/RunCounts"
        },
        "label": {
          "$ref": "#/$defs/RunLabel"
        },
        "run": {
          "$ref": "#/$defs/Run"
        }
      },
      "required": [
        "label",
        "run",
        "counts"
      ],
      "title": "RunDetail",
      "type": "object"
    },
    "RunLabel": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "kind": {
          "$ref": "#/$defs/RunLabelKind"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunLabel",
      "type": "object"
    },
    "RunLabelKind": {
      "enum": [
        "live",
        "recorded",
        "mock"
      ],
      "title": "RunLabelKind",
      "type": "string"
    },
    "RunStatus": {
      "description": "`draft` = run created, setup not yet done (D9).",
      "enum": [
        "draft",
        "running",
        "finished",
        "stopped_cap",
        "stopped_budget",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "drawn_by": {
          "enum": [
            "rule",
            "suggestion",
            "engineer"
          ],
          "title": "Drawn By",
