        "control_loop",
        "pump",
        "compressor",
        "check_valve",
        "regulator",
        "relief_device",
        "exchanger_tube",
        "interlock",
        "operator",
        "hose",
        "pipe",
        "tank",
        "external",
        "solids_handler",
        "utility_cooling",
        "utility_power"
      ],
      "title": "FailingComponentType",
      "type": "string"
    },
    "SeverityClass": {
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ],
      "title": "SeverityClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
