    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "consequence": {
      "title": "Consequence",
      "type": "string"
    },
    "failing_component_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
