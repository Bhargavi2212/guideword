      "type": "array"
    },
    "failing_component_type": {
      "$ref": "#/$defs/FailingComponentType"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "model_call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
