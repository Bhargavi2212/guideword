# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
TAVILY_API_KEY=

# Total Token Factory budget in US dollars (per-run cap and allowances live in config/caps.yaml)
GLOBAL_BUDGET_USD=25.00

# Where this process runs: laptop or hosted (recorded on every ledger line)
GUIDEWORD_ENV=laptop

# 1 = every API endpoint returns the fixtures in contract/fixtures (no model calls)
GUIDEWORD_MOCK=0

# Hosted only: secret header for POST /internal/runs/{id}/advance
INTERNAL_ADVANCE_SECRET=

# Development uses SQLite; the hosted demo uses Postgres
DATABASE_URL=sqlite:///./guideword.db
